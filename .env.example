# The Best Dreams - environment configuration example
# Copy to .env.local and fill in as integrations become available.
# NOTE: The current build uses a MOCK commerce layer. None of these are required yet.

# Commerce provider selector: "mock" (default) | "shopify" | "medusa"
NEXT_PUBLIC_COMMERCE_PROVIDER=mock

# --- Shopify (placeholder, unused with the mock provider) ---
# NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Medusa (placeholder, unused with the mock provider) ---
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# --- Site ---
# NEXT_PUBLIC_SITE_URL=https://thebestdreams.example
